# API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 或使用其他LLM
# ANTHROPIC_API_KEY=your_anthropic_key
# CLAUDE_MODEL=claude-3-opus

# Ollama配置
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# Review Settings
MAX_FILE_SIZE=100000  # 单文件最大行数
IGNORE_PATTERNS=["__pycache__", "*.pyc", "node_modules"]
STRICT_MODE=false     # 严格模式（更严格的检查）

# Report Settings
REPORT_FORMAT=markdown  # markdown, json, html
INCLUDE_SCORES=true
SHOW_EXAMPLES=true
